{
  "name": "rag-trust-evaluation",
  "version": "1.0.0",
  "description": "Master's thesis project.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "scrape:lute": "ts-node src/modules/scraper/scrape.service.ts",
    "ingest:corpus": "ts-node src/modules/ingest/ingest_corpus.ts",
    "index:corpus": "ts-node src/modules/vector/index_corpus.ts",
    "test:phase3": "ts-node src/tests/phase3.checks.ts",
    "benchmark:validate": "ts-node src/modules/evaluation/benchmark.cli.ts",
    "test:benchmark": "ts-node src/tests/benchmark.checks.ts && ts-node src/tests/annotation.queue.checks.ts && ts-node src/tests/annotation.review.checks.ts && ts-node src/tests/benchmark.report.checks.ts && ts-node src/tests/corpus.readiness.checks.ts",
    "benchmark:prepare": "ts-node src/modules/evaluation/annotation.queue.cli.ts",
    "benchmark:adjudicate": "ts-node src/modules/evaluation/annotation.review.cli.ts",
    "benchmark:score": "ts-node src/modules/evaluation/benchmark.report.cli.ts",
    "benchmark:audit": "ts-node src/modules/evaluation/corpus.readiness.cli.ts",
    "ocr:stage": "python scripts/ocr_stage.py",
    "test:ocr": "python -m unittest discover -s tests -p 'test_ocr_*.py'",
    "ocr:review-template": "python scripts/ocr_review_template.py",
    "ocr:review-export": "python scripts/ocr_review_export.py",
    "corpus:snapshot": "python scripts/assemble_reviewed_snapshot.py",
    "corpus:verify": "python scripts/verify_reviewed_snapshot.py"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.0",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/node-fetch": "^2.6.13",
    "@types/pdf-parse": "^1.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
